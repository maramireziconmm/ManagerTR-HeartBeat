{
  "RunMode": "InfoLineasEstado",
  "DenevaConfig": {
    "Path": "C:\\Deneva\\Resources\\Config\\deneva.config",
    "RabbitSection": "RabbitMQ.My.MySettings"
  },
  "Database": {
    "Engine": "mysql57"
    // "Engine": "mysql8"
  },
  "Jobs": {
    "Heartbeat": {
      "Enabled": true,
      "IntervalSeconds": 30,
      "OriginSystem": "DenevaManagerTR",
      "Msg_OriginSystem_HeartBeat": "Servidor_60",
      "Msg_topic_HeartBeat": "PorObjectIDPadre.60",
      "Msg_contentType_HeartBeat": "HeartBeat"
    },
    "InfoStation": {
      "Enabled": true,
      "AppId": "DenevaManagerTR",
      "QueueName": "InfoDenevaManagerTR",
      "Topics": [
        "#"
      ],
      "ResponseOriginSystem": "ManagerTR",
      "ResponseContentType": "SYNCINFOSTATION_RETURN",
      "ResponseTimeoutMs": 10000
    },
    "InfoLineasEstado": {
      "Enabled": true,
      "AppId": "DenevaManagerTR",
      "QueueName": "InfoLineasEstadoDenevaManagerTR",
      "Topics": [
        "#"
      ],
      "ResponseOriginSystem": "ManagerTR",
      "ResponseContentType": "SYNCINFOLINEASESTADOSTM_RETURN",
      "ResponseTimeoutMs": 10000
    }
  }
}